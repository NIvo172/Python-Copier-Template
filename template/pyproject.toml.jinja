{% if build_backend == "hatchling" -%}
[build-system]
requires = [
    "hatchling>=1.31",
    "hatch-vcs>=0.5",
]
build-backend = "hatchling.build"
{% else -%}
[build-system]
requires = [
    "setuptools>=80",
    "setuptools-scm[simple]>=10.2",
]
build-backend = "setuptools.build_meta"
{% endif %}

[project]
name = "{{ distribution_name }}"
dynamic = ["version"]
description = "{{ project_description }}"
readme = "README.md"
requires-python = ">={{ minimum_python_version }}"
license = "MIT"
license-files = ["LICENSE"]
authors = [
    { name = "{{ user_name }}", email = "{{ user_email }}" },
]
classifiers = [
    "Development Status :: 3 - Alpha",
    "License :: OSI Approved :: MIT License",
    "Operating System :: OS Independent",
{% for python_version in python_versions %}
    "Programming Language :: Python :: {{ python_version }}",
{% endfor %}
    "Programming Language :: Python :: 3 :: Only",
    "Typing :: Typed",
]
dependencies = []

{% if project_kind == "application" -%}
[project.scripts]
{{ distribution_name }} = "{{ package_name }}.main:main"

{% endif -%}
{% if repository_url or homepage_url or documentation_url or changelog_url -%}
[project.urls]
{% if homepage_url %}
Homepage = "{{ homepage_url }}"
{% endif %}
{% if documentation_url %}
Documentation = "{{ documentation_url }}"
{% endif %}
{% if repository_url %}
Repository = "{{ repository_url }}"
Issues = "{{ repository_url }}/issues"
{% endif %}
{% if changelog_url %}
Changelog = "{{ changelog_url }}"
{% endif %}

{% endif -%}
{% if build_backend == "hatchling" -%}
[tool.hatch.version]
source = "vcs"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

{% endif -%}
[dependency-groups]
test = [
    "pytest>=8.4",
    "pytest-cov>=6.2",
    "pytest-html>=4.1",
    "pytest-mock>=3.14",
    "pytest-reportlog>=1.0",
    "pytest-xdist>=3.8",
{% if project_kind == "data_science" %}
    "pytest-datadir>=1.8",
{% endif %}
]

package-check = [
    "check-wheel-contents>=0.6.3,<0.7",
    "twine>=6.2,<8",
]

lint = [
    "format-docstring>=0.4,<0.5",
    "mypy>=1.17",
    "pytest>=8.4",
{% if use_notebooks %}
    "nbstripout==0.9.1",
{% endif %}
{% if use_precommit %}
    "pre-commit>=4.6",
{% endif %}
    "ruff>=0.15",
]

{% if project_kind == "data_science" and use_dvc -%}
dvc = [
    "dvc>=3.67,<4",
]

{% endif -%}
{% if use_notebooks -%}
notebooks = [
    "ipykernel>=6",
    "jupyterlab>=4",
]

{% endif -%}
{% if use_docs -%}
docs = [
    "furo>=2025.7",
    "myst-parser>=4",
{% if use_notebooks %}
    "myst-nb>=1.3",
{% endif %}
{% if use_uml %}
    "pylint>=3.3",
    "sphinxcontrib-mermaid>=2,<3",
{% endif %}
{% if use_example_gallery %}
    "matplotlib>=3.9",
    "sphinx-gallery>=0.21",
{% endif %}
    "sphinx>=8",
    "sphinx-copybutton>=0.5",
    "sphinx-inline-tabs>=2023.4",
]

{% endif -%}
dev = [
    { include-group = "test" },
    { include-group = "lint" },
    { include-group = "package-check" },
{% if project_kind == "data_science" and use_dvc %}
    { include-group = "dvc" },
{% endif %}
{% if use_notebooks %}
    { include-group = "notebooks" },
{% endif %}
{% if use_docs %}
    { include-group = "docs" },
{% endif %}
    "tox>=4.44",
    "tox-uv>=1.35",
    "pytest-sugar>=1.1",
]

[tool.uv]
cache-keys = [
    { file = "pyproject.toml" },
    { git = { commit = true, tags = true } },
]

[tool.pytest.ini_options]
required_plugins = [
    "pytest-cov>=6.2",
    "pytest-html>=4.1",
    "pytest-mock>=3.14",
    "pytest-reportlog>=1.0",
    "pytest-xdist>=3.8",
{% if project_kind == "data_science" %}
    "pytest-datadir>=1.8",
{% endif %}
]
addopts = """
-ra
--strict-config
--strict-markers
--cov={{ package_name }}
--cov-context=test
--cov-report=term-missing
--cov-report=html:reports/coverage/html
--cov-report=xml:reports/coverage/coverage.xml
--cov-report=json:reports/coverage/coverage.json
--html=reports/pytest/report.html
--self-contained-html
--report-log=reports/pytest/report.jsonl
"""
testpaths = ["tests"]
log_cli = false
log_file = "reports/pytest/logs/pytest.log"
log_file_level = "INFO"
log_file_format = "%(asctime)s [%(levelname)s] %(name)s: %(message)s"
log_file_date_format = "%Y-%m-%dT%H:%M:%S"

[tool.coverage.run]
source = ["{{ package_name }}"]
branch = true
relative_files = true

[tool.coverage.report]
fail_under = 80
show_missing = true
skip_covered = true

[tool.coverage.html]
directory = "reports/coverage/html"
show_contexts = true
skip_empty = true

[tool.mypy]
python_version = "{{ minimum_python_version }}"
files = ["src", "tests"]
strict = true
warn_unreachable = true
pretty = true
show_error_codes = true
show_error_code_links = true

[tool.format_docstring]
line_length = 121
docstring_style = "{{ docstring_style }}"
fix_rst_backticks = true
{% if docstring_style == "google" -%}
include_arg_types = false
include_arg_defaults = false
include_return_and_yield_types = false
{% else -%}
include_arg_types = true
include_arg_defaults = true
include_return_and_yield_types = true
{% endif -%}
exclude = "\\.git|\\.venv|\\.tox|__pycache__|build|dist|reports"

[tool.ruff]
target-version = "py{{ minimum_python_version | replace('.', '') }}"
line-length = 121
force-exclude = true
extend-exclude = [
    ".git",
    ".mypy_cache",
    ".pytest_cache",
    ".ruff_cache",
    ".tox",
    ".venv",
    "build",
    "dist",
    "docs/_build",
    "reports",
]

[tool.ruff.lint]
select = [
    "ANN",
    "B",
    "C4",
    "D",
    "DTZ",
    "E4",
    "E7",
    "E9",
    "F",
    "G",
    "I",
{% if project_kind == "data_science" %}
    "ICN",
{% endif %}
    "LOG",
{% if project_kind == "data_science" %}
    "NPY",
{% endif %}
    "PTH",
    "RUF",
    "S",
    "SIM",
    "T20",
    "UP",
]
ignore = [
    "ANN401",
    "D203",
    "D213",
]

[tool.ruff.lint.per-file-ignores]
"tests/**/*.py" = ["D", "S101"]
"docs/source/conf.py" = ["D100"]
"scripts/**/*.py" = ["S603", "S607", "T201"]
"src/**/main.py" = ["T201"]
{% if use_example_gallery %}
"examples/**/*.py" = ["D205", "D415"]
{% endif %}
{% if use_notebooks %}
"notebooks/**/*.ipynb" = ["ANN", "D", "E402", "S101", "T20"]
"docs/source/notebooks/**/*.ipynb" = ["ANN", "D", "E402", "S101", "T20"]
{% endif %}

[tool.ruff.lint.pydocstyle]
convention = "{{ docstring_style }}"

[tool.ruff.format]
quote-style = "double"
indent-style = "space"
line-ending = "auto"
docstring-code-format = true
docstring-code-line-length = "dynamic"
